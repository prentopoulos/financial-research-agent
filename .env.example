SEC_USER_AGENT="Ledger Research your-email@example.com"

# Bring your own OpenAI or OpenAI-compatible model account.
# Calls are billed by that provider to your account. Leave the key blank for deterministic fallback mode.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"
MODEL_PROVIDER="OpenAI"

# Optional LangSmith tracing for the LangGraph workflow.
# Only enable this after reviewing the public-data-only tracing boundary in docs/SECURITY.md.
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="ledger-financial-research"
