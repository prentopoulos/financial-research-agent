SEC_USER_AGENT="Ledger Research your-email@example.com"

# Bring your own OpenAI or OpenAI-compatible model account.
# Calls are billed by that provider to your account. Leave the key blank for deterministic fallback mode.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"
MODEL_PROVIDER="OpenAI"
# GPT-5 report tasks are bounded extraction and prose jobs; minimal reduces wait without changing the Python analysis.
OPENAI_REASONING_EFFORT="minimal"
# Web-backed Responses uses low reasoning by default; increase only after evaluating answer quality and latency.
OPENAI_EXPLORE_REASONING_EFFORT="low"
# Low keeps Explore responsive; raise to medium or high when broader source coverage matters more than latency.
OPENAI_WEB_SEARCH_CONTEXT_SIZE="low"

# Optional LangSmith tracing for the LangGraph workflow.
# Only enable this after reviewing the public-data-only tracing boundary in docs/SECURITY.md.
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="ledger-financial-research"
