{
  "name": "ledger-launch-film",
  "version": "1.0.0",
  "private": true,
  "description": "Editable Remotion launch film for Ledger",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts LedgerLaunch out/ledger-still.png --frame=750",
    "render": "remotion render src/index.ts LedgerLaunch out/ledger-launch.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709 --x264-preset=slow",
    "render:vertical": "remotion render src/index.ts LedgerLaunchVertical out/ledger-launch-vertical.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709 --x264-preset=slow",
    "render:all": "npm run render && npm run render:vertical",
    "typecheck": "tsc --noEmit",
    "audio": "python scripts/generate-audio.py"
  },
  "keywords": ["ledger", "remotion", "product-video"],
  "license": "UNLICENSED",
  "devDependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@remotion/bundler": "4.0.454",
    "@remotion/cli": "4.0.454",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.454"
  }
}
